# ==============================================================================
# TECHX ATTENDANCE & EVENT MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- BACKEND CONFIGURATION (FastAPI) ---
PROJECT_NAME="TechX Attendance & Event Management System"
VERSION="1.0.0"
API_V1_STR="/api"

# Database:
# For local zero-dependency testing, defaults to SQLite:
# DATABASE_URL="sqlite:///./techx_attendance.db"
#
# For production PostgreSQL / Supabase, supply standard connection string:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="sqlite:///./techx_attendance.db"

# JWT Security:
# Generate a cryptographically strong secret with: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Barcode GIF Assets Directory (Absolute path or relative to workspace)
BARCODE_DIR="./barcodes"

# --- FRONTEND CONFIGURATION (Next.js) ---
# Point to running backend FastAPI instance
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api"
